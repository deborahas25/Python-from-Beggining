class Solution(object):
    def myAtoi(self, s):
        """
        :type s: str
        :rtype: int
        """
        s = s.strip()
        if not s:
            return 0
        
        sign  = 1
        if s[0] == "-" or s[0] == "+":
            if s[0] == '-':
                sign = -1
            s = s[1:]
        
        hasil = 0
        for char in s:
            if not char.isdigit():
                break
            hasil = hasil * 10 + int(char)
        
        hasil = hasil *sign
        
        if hasil < -2**31:
            return -2**31
        elif hasil > 2**31-1:
            return 2**31-1
        
        return hasil
    


        
        
