class Solution(object):
    def twoSum(self, nums, target):
        """
        :type nums: List[int]
        :type target: int
        :rtype: List[int]
        """
        angka = {}
        for i in range(len(nums)):
            minus = target - nums[i]
            if minus in angka:
                return [angka[minus], i]
            angka[nums[i]] = i
                    
        
