class Solution(object):
    def longestCommonPrefix(self, strs):
        """
        :type strs: List[str]
        :rtype: str
        """
        
        res = "" // as a container for the prefix

        for i in range(len(strs[0])): // start from strs[0]. why? => All strings should share the same prefix as strs[0]. If any string doesn't match, we're done.
            for s in strs: // check every words in strs
                if i == len(s) or s[i] != strs[0][i]: // if any string in strs has different prefix at the current position, we stop here. => null
                    return res
            res += strs[0][i] => the prefix
        
        return res
